# Copy to .env next to this file and fill in. Keep it readable by the watcher's
# user only (chmod 600 on Linux).
#
# Numeric settings are validated at startup and the watcher refuses to boot on a
# bad one, with the accepted range in the message. This used to be a bare
# parseInt, which truncates at the first non-digit and accepts zero and
# negatives — so TIMEOUT_MINUTES=1o silently meant 1, and MAX_CONCURRENT_AGENTS
# =0x8 parsed as 0 and stalled the queue with nothing in the log. Blank is
# always valid and means "use the default".
#
# dotenv never overrides a variable already set in the process environment, so
# a value exported by the shell or service manager wins over this file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Claude API ─────────────────────────────────────────────────────
# Key from the Claude Console (platform.claude.com → API keys), in the org that
# receives the Max plan's monthly API credits. Those credits cover the Claude API
# but NOT Claude Code. Put the key here and nowhere else: as a Windows (or shell)
# environment variable, Claude Code would pick it up too and the owner's own
# sessions would start failing with "Credit balance too low".
ANTHROPIC_API_KEY=
# Defaults: claude-opus-5-5 at medium effort. Effort is low | medium | high |
# xhigh | max. Prefixed so Claude Code's own CLAUDE_* variables can't leak in.
CELLAR27_MODEL=
CELLAR27_EFFORT=

# Requests stuck in 'picked_up' longer than this are swept by the DB
# function cellar27_sweep_stale_claims: reset to 'pending' (up to 2
# retries), then 'error'. Also sets the per-attempt API timeout, so that a
# call and its retries finish inside this window.
TIMEOUT_MINUTES=10

# Global circuit breaker: max Claude API calls per UTC day across all users.
# Tracked in cellar27_watcher_metrics in Postgres so it survives watcher
# restarts. With API credits each call has a cost (see watcher/README.md).
MAX_CLAUDE_CALLS_PER_DAY=250

# Watcher-side per-user rate limit (in-memory, cleared on restart).
# Redundant with the DB-layer cellar27_check_rate_limit; this is the
# defense-in-depth backstop. Bump if you ever bulk-add inventory.
WATCHER_RATE_LIMIT_PER_HOUR=100

# How many API calls may run at once. Extra requests queue FIFO rather than
# being dropped.
MAX_CONCURRENT_AGENTS=3

# ── Email notifications when a limit fires ─────────────────────────
# Leave any of these blank to disable notifications silently.
# Gmail: use an App Password (Account Settings → Security → 2FA →
# App passwords). Resend / Mailgun / SES SMTP also work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
# Suppress further sends of the same limit-key for this many ms
# after one fires. Default 30 min.
NOTIFY_COOLDOWN_MS=1800000

# Comma-separated user UUIDs allowed to consume bridge compute.
# Get a user's UUID from: select id, email from auth.users;
# Empty/unset = open mode — only safe if Supabase "Allow new users to
# sign up" is OFF.
ALLOWED_USER_IDS=

# ── Current weather context (Open-Meteo, no API key) ───────────────
# If LOCATION_LAT and LOCATION_LON are set, the watcher fetches current
# temperature + conditions and adds them to every Claude request, so
# recommendations can react to actual weather instead of the model
# hallucinating "warm spring day" from the timezone alone. Cached 30 min;
# 4s timeout; degrades silently if the API is down or these are unset.
# LOCATION_NAME is optional and just makes the prompt read more naturally
# ("48°F, drizzle, high 52°F in <name>").
# Find your coords with any maps app (right-click → "What's here").
LOCATION_LAT=
LOCATION_LON=
LOCATION_NAME=
