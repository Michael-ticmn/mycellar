.claude/
*.code-workspace

# Local secrets / config
**/.env
**/.env.local
docs/config.local.js

# Node
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*

# Watcher runtime logs — glob, not exact names, so rotated/backup copies
# (watcher.out.log.20260801-175058.bak) can't slip in. They contain absolute
# local paths and the machine hostname.
watcher/watcher.out.log*
watcher/watcher.err.log*

# Data snapshots. scripts/backup-data.mjs writes outside the repo by default,
# but --out could point here, and these hold prices, notes and guest names.
cellar27-backups/
*-backup/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Private planning docs — kept on local disk, not pushed to GitHub.
# REVIEW_FINDINGS.md is an unpatched-issue register for a live deployment;
# it stays local until everything in it is fixed.
REVIEW_FINDINGS.md
STRATEGY.md
BUILD_SPEC.md
BUILD_LOG.md
CURRENT_STATE.md
HANDOFF_QUEUE.md
HOUSEHOLD_MEMBERS_SKETCH.md
